---
import { headerLinks, donateLink, siteHome, resolveHref } from '../nav';

const currentUrl = Astro.url.toString();
// Use the configured production origin (Astro.site) rather than the request
// origin, so links resolve correctly in dev (where both sites run on localhost).
const currentOrigin = Astro.site?.origin ?? Astro.url.origin;

// nav.ts links have no trailing slash ('/install'); sites that build trailing-slash URLs don't.
const trimSlash = (pathname: string) => pathname.replace(/\/+$/, '') || '/';

function isCurrent(href: string): boolean {
  try {
    const a = new URL(href);
    // During a static build Astro.url carries the dev-server origin (http://localhost:4321),
    // so compare against the production origin, as the links do.
    const b = new URL(new URL(currentUrl).pathname, currentOrigin);
    return a.origin === b.origin && trimSlash(a.pathname) === trimSlash(b.pathname);
  } catch {
    return false;
  }
}
---

<header class="jr-site-header">
  <div class="jr-site-header-inner">
    <a class="jr-site-logo" href={resolveHref(siteHome.href, currentOrigin)}>{siteHome.text}</a>

    <nav class="jr-site-nav" aria-label="Site navigation">
      {headerLinks.map((link) => <a
        href={resolveHref(link.href, currentOrigin)}
        aria-current={isCurrent(link.href) ? 'page' : undefined}
      >
        {link.text}
      </a>)}
    </nav>

    <div class="jr-site-header-extra">
      <slot name="extra" />
    </div>

    <a class="jr-site-donate" href={resolveHref(donateLink.href, currentOrigin)}>
      {donateLink.text}
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path
          d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
        ></path>
      </svg>
    </a>

    {/*
      Small screens: the links above are hidden, so a menu button opens them in a popover.
      Native `popover` needs no JavaScript, so it works under the sites' strict
      `script-src 'self'` CSP; the browser closes it on Esc or a tap outside.
    */}
    <button class="jr-site-menu-button" type="button" popovertarget="jr-site-menu" aria-label="Site menu">
      <svg
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
    <nav id="jr-site-menu" class="jr-site-menu" popover aria-label="Site menu">
      {headerLinks.map((link) => <a
        href={resolveHref(link.href, currentOrigin)}
        aria-current={isCurrent(link.href) ? 'page' : undefined}
      >
        {link.text}
      </a>)}
      <a class="jr-site-menu-donate" href={resolveHref(donateLink.href, currentOrigin)}>{donateLink.text}</a>
    </nav>
  </div>
</header>
